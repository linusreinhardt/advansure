# ---------------------------------------------------------------------------
# Supabase – Werte unter: Supabase Dashboard -> Project Settings -> API
# Kopiere diese Datei zu ".env.local" und trage echte Werte ein.
# ---------------------------------------------------------------------------

# Öffentlich (werden in den Browser eingebettet – das ist beabsichtigt):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# GEHEIM – nur serverseitig! Darf NIEMALS im Client landen und niemals
# mit dem Prefix NEXT_PUBLIC_ versehen werden:
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY
