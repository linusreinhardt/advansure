# ---------------------------------------------------------------------------
# Advansure – Umgebungsvariablen (Vorlage)
# Kopieren nach .env.local und Werte eintragen. .env.local wird NICHT committet.
# ---------------------------------------------------------------------------

# Supabase (Schicht 3: Postgres, Storage, Auth)
NEXT_PUBLIC_SUPABASE_URL="https://<projekt>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Google AI Studio (Schicht 3: Gemini, multimodal)
# Sobald dieser Key gesetzt ist, übernimmt Gemini Avery-Dialog (TU-02) und
# Foto-Walk-Analyse (TU-04). Ohne Key läuft die App im PoC-Modus (Engine/Mock).
GOOGLE_AI_STUDIO_API_KEY="<api-key>"
# Optional: multimodales Modell (Default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"
